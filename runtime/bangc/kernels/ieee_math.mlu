// Certified 0-ULP IEEE-754 binary32 round-to-nearest-even vector division and
// square root on MLU370 NRAM.
//
// Argument structure for 0-ULP correctness:
//   1. Correctness relies EXCLUSIVELY on unconditional, symmetric, exact
//      runtime endpoint certification of each candidate float r, backed by an
//      exact per-lane scalar fallback (__cn_scalar_div_f32_rn for division,
//      bit-exact integer restoring scalar_sqrt_f32_rn for square root).
//      No correctness property is assumed of the fast-path initial approximation
//      (y0, reciprocal LUT, Newton-Raphson steps, or candidate correction), and
//      no directional assumption (such as x < y0^2) is made anywhere.
//   2. A priori accuracy of the fast-path candidate (~2^-40 relative error on
//      interior normal inputs) serves ONLY to explain why the fallback rate is
//      negligible (< 10^-6 on interior normals, triggered only at exact powers
//      of two or tie-adjacent inputs); it bears zero load in the soundness proof.
//
// Soundness of the runtime endpoint certificates:
//
// [A] Square root (vec_sqrt_rn):
//   Given input x and untrusted candidate r = dst[i], lane i is accepted iff
//   all runtime checks (C1)-(C5) evaluate to 0 (otherwise scalar_sqrt_f32_rn(x)
//   overwrites dst[i]):
//     (C1) 0x19800000 <= x_bits < 0x72800000 (signed int32): x is finite
//          positive normal in [2^-76, 2^102) (rejects negatives, +-0, subnormals,
//          Inf, and NaN). Every such x is an integer multiple of >= 2^-99.
//     (C2) 0x2c800001 <= r_bits < 0x59000000 (signed int32) and
//          (r_bits & 0x007fffff) != 0: r is finite positive normal in
//          (2^-38, 2^51) and not an exact power of two. Writing r = M * delta
//          with integer M in [2^23 + 1, 2^24 - 1] and delta = ulp(r) =
//          2^(exp(r) - 150) in [2^-61, 2^27], both adjacent binary32 floats of
//          r are symmetrically r - delta and r + delta, so the exact IEEE-754
//          RN rounding interval around r has midpoints m_- = r - 0.5 * delta > 0
//          and m_+ = r + 0.5 * delta > 0. Thus m_-^2 < x < m_+^2, i.e.,
//            -r * delta + 0.25 * delta^2 < x - r^2 < r * delta + 0.25 * delta^2,
//          suffices unconditionally for RN(sqrt(x)) == r.
//     (C3) Masking with 0xfffff000U splits r = r_hi + r_lo into <=12-bit halves.
//          All three products P0 = r_hi^2 in [2^-76, 2^102), P1 = 2*r_hi*r_lo
//          (0 or >= 2^-109), and P2 = r_lo^2 (0 or >= 2^-122) have <=24
//          significand bits and are integer multiples of delta^2 >= 2^-122 >
//          2^-126, hence exact in binary32 without overflow or subnormal FTZ.
//          Runtime check -0x00800000 <= (x_bits & 0x7fffffff) -
//          (P0_bits & 0x7fffffff) <= +0x00800000 verifies 0.5 * P0 <= x <= 2 * P0
//          directly on (x, P0); since both are multiples of >= 2^-99 > 2^-126,
//          Sterbenz's Lemma guarantees r0 = fl(x - P0) = x - P0 is exact.
//     (C4) Knuth TwoDiff(r0, P1) -> (s1, e1) and TwoDiff(s1, P2) -> (R_hi, e2).
//          Because x >= 0.5 * P0 >= 2^45 * delta^2 has ulp(x) >= 2^22 * delta^2,
//          every operand and intermediate in both TwoDiff steps is an integer
//          multiple of delta^2 >= 2^-122 > 2^-126 with magnitude < 2^103, so
//          neither FTZ nor overflow can occur and x - r^2 = R_hi + e1 + e2
//          holds with mathematical exactness. Runtime checks (e1_bits & 0x7fffffff)
//          == 0 and (e2_bits & 0x7fffffff) == 0 certify R_hi == x - r^2 exactly.
//     (C5) tau = fl(r * delta) = M * delta^2 in (2^-99, 2^78) is exact. Runtime
//          check |R_hi| < tau (evaluated symmetrically on non-negative bit
//          patterns as tau_bits - |R_hi|_bits >= 1, which also rejects Inf/NaN)
//          certifies -tau < x - r^2 < +tau. Since R_hi = K * delta^2 and
//          tau = M * delta^2 are both integer multiples of delta^2, |K| < M
//          implies -M + 1 <= K <= M - 1, hence -M + 0.25 < K < M + 0.25 and
//          m_-^2 < x < m_+^2 on both boundaries, proving RN(sqrt(x)) == r.
//
// [B] Division (vec_div_rn / scalar_div_vec_rn / vec_div_scalar_rn):
//   Given dividend a, divisor b, and untrusted candidate r = dst[i], lane i is
//   accepted iff all runtime checks (D1)-(D5) in certify_div_rn_lanes pass
//   (otherwise __cn_scalar_div_f32_rn(a, b) overwrites dst[i]):
//     (D1) |a|_bits in [0x00800000, 0x7f800000) and |b|_bits in
//          [0x0d800000, 0x72800000): scale = sgn(b) * 2^(127 - exp(b)) in
//          [2^-101, 2^100] is an exact normal power of two, and b' = fl(b*scale)
//          = b * scale in [1, 2) is exact (b' > 0). Runtime check |a'|_bits in
//          [0x19800000, 0x72800000) on a' = fl(a * scale) guarantees a * scale
//          experienced neither subnormal rounding/FTZ nor overflow, so a' =
//          a * scale is exact and a / b == a' / b' identically.
//     (D2) |r|_bits in [0x19800001, 0x72000000) and (r_bits & 0x007fffff) != 0:
//          r is finite normal with |r| in (2^-76, 2^101) and not a power of two,
//          so adjacent binary32 floats of r are symmetrically r - delta and
//          r + delta with delta = ulp(r) = 2^(exp(r) - 150) in [2^-99, 2^77].
//          Since b' > 0, the strict symmetric inequality
//            -0.5 * b' * delta < a' - r * b' < +0.5 * b' * delta
//          implies r - 0.5 * delta < a / b < r + 0.5 * delta, which suffices
//          unconditionally for RN(a / b) == r (exact midpoint ties fail strict
//          < and are resolved by exact scalar fallback).
//     (D3) Masking b' = b_hi + b_lo and r = r_hi + r_lo with 0xfffff000U gives
//          exact <=24-bit products P00 = b_hi*r_hi, P10 = b_hi*r_lo,
//          P01 = r_hi*b_lo, P11 = b_lo*r_lo, all integer multiples of
//          u0 = 2^-23 * delta >= 2^-122 > 2^-126 (no FTZ, no overflow). Runtime
//          checks signbit(a') == signbit(P00) and -0x00800000 <= |a'|_bits -
//          |P00|_bits <= +0x00800000 verify 0.5*|P00| <= |a'| <= 2*|P00|; since
//          |a'| >= 0.5*|P00| >= 2^22 * delta has ulp(a') >= 0.5 * delta =
//          2^22 * u0, Sterbenz's Lemma guarantees r0 = fl(a' - P00) = a' - P00
//          is exact and an integer multiple of u0.
//     (D4) Knuth TwoDiff(r0, P10) -> (sA, eA), TwoDiff(sA, P01) -> (sB, eB),
//          TwoDiff(sB, -eA) -> (sC, eAB), and TwoDiff(sC, P11) -> (R_hi, eC).
//          Every operand and intermediate is an integer multiple of u0 >= 2^-122
//          > 2^-126 with magnitude < 2^104, so a' - r * b' = R_hi + eB + eAB + eC
//          holds exactly without FTZ or overflow. Runtime checks eB == 0,
//          eAB == 0, and eC == 0 certify R_hi == a' - r * b' with zero error.
//     (D5) half_delta = 0.5 * delta = 2^(exp(r) - 151) in [2^-100, 2^76] is an
//          exact normal power of two, so tau = fl(b' * half_delta) =
//          0.5 * b' * delta in [2^-100, 2^77) is exact. Runtime symmetric check
//          tau_bits - |R_hi|_bits >= 1 certifies -tau < a' - r * b' < +tau on
//          both sides (and rejects Inf/NaN), proving RN(a / b) == r (0 ULP).

#define BANG_TWODIFF(u, v, t1, t2, n)                                          \
  do {                                                                         \
    __bang_sub(t1, u, v, n);                                                   \
    __bang_add(t2, t1, v, n);                                                  \
    __bang_sub(u, u, t2, n);                                                   \
    __bang_sub(t2, t2, t1, n);                                                 \
    __bang_sub(v, t2, v, n);                                                   \
    __bang_add(v, u, v, n);                                                    \
    __bang_bor((char *)(u), (const char *)(t1), (const char *)(t1), (n) * 4);  \
  } while (0)

__mlu_func__ float scalar_sqrt_f32_rn(float x) {
  union {
    float f;
    unsigned u;
  } ux;
  ux.f = x;
  unsigned u = ux.u;
  unsigned mag = u & 0x7fffffffU;
  if (mag == 0U)
    return x; // preserves +0.0f and -0.0f
  if (mag > 0x7f800000U)
    return x; // propagates NaN
  if ((u >> 31) != 0U) {
    ux.u = 0x7fc00000U;
    return ux.f; // negative -> qNaN
  }
  if (u == 0x7f800000U)
    return x; // +Inf -> +Inf

  int exp = (int)((u >> 23) & 0xffU) - 127;
  unsigned m = u & 0x7fffffU;
  if (((u >> 23) & 0xffU) == 0U) {
    exp = -126;
    while ((m & 0x800000U) == 0U) {
      m <<= 1;
      --exp;
    }
  } else {
    m |= 0x800000U;
  }
  if (exp & 1) {
    m <<= 1;
    --exp;
  }
  int out_exp = (exp >> 1) + 127;

  // Compute root = floor(sqrt(m * 2^25)) in [2^24, 2^25) using pure 32-bit
  // restoring digit-by-digit square root (zero 64-bit ALU ops). Since m * 2^25
  // is even while (2k + 1)^2 is odd, (root + 1) >> 1 is exact RN-even for all x.
  unsigned rem = 0U;
  unsigned root = 0U;
  unsigned hi = m << 7;
  for (int i = 0; i < 25; ++i) {
    rem = (rem << 2) | (hi >> 30);
    hi <<= 2;
    unsigned cand = (root << 2) | 1U;
    root <<= 1;
    if (rem >= cand) {
      rem -= cand;
      root |= 1U;
    }
  }
  unsigned sig = (root + 1U) >> 1;
  if (sig == (1U << 24)) {
    sig >>= 1;
    ++out_exp;
  }
  ux.u = ((unsigned)out_exp << 23) | (sig & 0x7fffffU);
  return ux.f;
}

// Unconditional symmetric runtime endpoint certification for candidate r = dst
// against sqrt(src), writing per-lane fault flags (0 = certified 0-ULP,
// !=0 = fallback) into s5 = sc + 5 * lanes.
__mlu_func__ void certify_sqrt_rn_lanes(float *dst, const float *src, float *sc,
                                        int lanes) {
  float *s0 = sc;
  float *s1 = sc + lanes;
  float *s2 = sc + 2 * lanes;
  float *s3 = sc + 3 * lanes;
  float *s4 = sc + 4 * lanes;
  float *s5 = sc + 5 * lanes;

  // (C1) x in [2^-76, 2^102) positive finite normal.
  __bang_lt_scalar((int *)s5, (const int *)src, 0x19800000, lanes);
  __bang_ge_scalar((int *)s4, (const int *)src, 0x72800000, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);

  // (C2) r in (2^-38, 2^51) positive normal and non-power-of-two (M > 2^23).
  __bang_lt_scalar((int *)s3, (const int *)dst, 0x2c800001, lanes);
  __bang_ge_scalar((int *)s4, (const int *)dst, 0x59000000, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s3, lanes * 4);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);
  __bang_band_scalar((int *)s3, (const int *)dst, 0x007fffff, lanes);
  __bang_lt_scalar((int *)s3, (const int *)s3, 1, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s3, lanes * 4);

  // (C3) Exact 12+12 split of r and runtime Sterbenz check 0.5*P0 <= x <= 2*P0.
  __bang_band_scalar((int *)s0, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_sub(s1, dst, s0, lanes);
  __bang_mul(s2, s0, s0, lanes);
  __bang_band_scalar((int *)s3, (const int *)src, 0x7fffffff, lanes);
  __bang_band_scalar((int *)s4, (const int *)s2, 0x7fffffff, lanes);
  __bang_mul_scalar((int *)s4, (const int *)s4, -1, lanes);
  __bang_add((int *)s3, (const int *)s3, (const int *)s4, lanes);
  __bang_lt_scalar((int *)s4, (const int *)s3, -0x00800000, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);
  __bang_ge_scalar((int *)s4, (const int *)s3, 0x00800001, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);

  // (C4) Exact TwoDiff chain for R_hi + e1 + e2 == x - r^2; require e1 == e2 == 0.
  __bang_sub(s2, (float *)src, s2, lanes);
  __bang_mul(s3, s0, s1, lanes);
  __bang_add(s3, s3, s3, lanes);
  __bang_mul(s0, s1, s1, lanes);
  BANG_TWODIFF(s2, s3, s1, s4, lanes);
  __bang_band_scalar((int *)s3, (const int *)s3, 0x7fffffff, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s3, lanes * 4);
  BANG_TWODIFF(s2, s0, s1, s4, lanes);
  __bang_band_scalar((int *)s0, (const int *)s0, 0x7fffffff, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s0, lanes * 4);

  // (C5) Symmetric exact endpoint check: -tau < R_hi < +tau (tau = r * ulp(r)).
  __bang_band_scalar((int *)s0, (const int *)dst, 0x7f800000, lanes);
  __bang_add_scalar((int *)s0, (const int *)s0, -0x0b800000, lanes);
  __bang_mul(s0, dst, s0, lanes);
  __bang_band_scalar((int *)s2, (const int *)s2, 0x7fffffff, lanes);
  __bang_mul_scalar((int *)s2, (const int *)s2, -1, lanes);
  __bang_add((int *)s0, (const int *)s0, (const int *)s2, lanes);
  __bang_lt_scalar((int *)s0, (const int *)s0, 1, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s0, lanes * 4);
}

__mlu_func__ void vec_sqrt_rn(float *dst, const float *src, float *sc, int live,
                              int lanes) {
  if (live <= 0)
    return;
  if (dst == src) {
    __sync_compute();
    for (int i = 0; i < live; ++i)
      dst[i] = scalar_sqrt_f32_rn(src[i]);
    return;
  }
  float *s0 = sc;
  float *s1 = sc + lanes;
  float *s2 = sc + 2 * lanes;
  float *s3 = sc + 3 * lanes;
  float *s4 = sc + 4 * lanes;
  float *s5 = sc + 5 * lanes;

  // Heuristic candidate generation (untrusted; only reduces fallback rate).
  __bang_sqrt(dst, src, lanes);
  __bang_add(s1, dst, dst, lanes);
  __bang_band_scalar((int *)s0, (const int *)s1, 0x7f800000, lanes);
  __bang_mul_scalar((int *)s0, (const int *)s0, -1, lanes);
  __bang_add_scalar((int *)s0, (const int *)s0, 0x7f000000, lanes);
  __bang_mul(s2, s1, s0, lanes);
  __bang_active_recip(s3, s2, lanes);
  __bang_mul(s4, s2, s3, lanes);
  __bang_mul_scalar(s4, s4, -1.0f, lanes);
  __bang_add_scalar(s4, s4, 2.0f, lanes);
  __bang_mul(s3, s3, s4, lanes);
  __bang_mul(s4, s2, s3, lanes);
  __bang_mul_scalar(s4, s4, -1.0f, lanes);
  __bang_add_scalar(s4, s4, 2.0f, lanes);
  __bang_mul(s3, s3, s4, lanes);
  __bang_mul(s0, s3, s0, lanes);

  __bang_band_scalar((int *)s1, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_sub(s2, dst, s1, lanes);
  __bang_mul(s3, s1, s1, lanes);
  __bang_sub(s3, (float *)src, s3, lanes);
  __bang_mul(s1, s1, s2, lanes);
  __bang_add(s1, s1, s1, lanes);
  BANG_TWODIFF(s3, s1, s4, s5, lanes);
  __bang_mul(s2, s2, s2, lanes);
  __bang_sub(s1, s1, s2, lanes);
  __bang_add(s2, s3, s1, lanes);
  __bang_mul(s2, s2, s0, lanes);
  __bang_add(dst, dst, s2, lanes);

  certify_sqrt_rn_lanes(dst, src, sc, lanes);

  __bang_ne_scalar((int *)s5, (const int *)s5, 0, lanes);
  __bang_int322float(s0, (const int *)s5, lanes, 0);
  unsigned bad = __bang_count(s0, live);
  if (bad > 0) {
    __sync_compute();
    if (bad <= 16) {
      for (unsigned k = 0; k < bad; ++k) {
        unsigned idx = __bang_findfirst1(s0, live);
        ((volatile float *)dst)[idx] = scalar_sqrt_f32_rn(src[idx]);
        ((volatile float *)s0)[idx] = 0.0f;
        __sync_compute();
      }
    } else {
      for (int i = 0; i < live; ++i)
        if (((const volatile int *)s5)[i] != 0)
          dst[i] = scalar_sqrt_f32_rn(src[i]);
    }
  }
}

// Unconditional symmetric runtime endpoint certification for candidate r = dst
// against a / b, writing per-lane fault flags (0 = certified 0-ULP, !=0 = fallback)
// into s5 = sc + 5 * lanes.
__mlu_func__ void certify_div_rn_lanes(float *dst, const float *a_vec,
                                       float a_scalar, int a_is_vec,
                                       const float *b_vec, float b_scalar,
                                       int b_is_vec, float *sc, int lanes) {
  float *s0 = sc;
  float *s1 = sc + lanes;
  float *s2 = sc + 2 * lanes;
  float *s3 = sc + 3 * lanes;
  float *s4 = sc + 4 * lanes;
  float *s5 = sc + 5 * lanes;

  // Clear fault mask s5.
  __bang_band_scalar((int *)s5, (const int *)dst, 0, lanes);

  // (D1) Normal finite dividend a and interior normal divisor b in [2^-100, 2^102).
  if (a_is_vec) {
    __bang_band_scalar((int *)s0, (const int *)a_vec, 0x7fffffff, lanes);
    __bang_lt_scalar((int *)s3, (const int *)s0, 0x00800000, lanes);
    __bang_ge_scalar((int *)s4, (const int *)s0, 0x7f800000, lanes);
    __bang_bor((char *)s5, (const char *)s5, (const char *)s3, lanes * 4);
    __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);
  }
  if (b_is_vec) {
    __bang_band_scalar((int *)s0, (const int *)b_vec, 0x7fffffff, lanes);
    __bang_lt_scalar((int *)s3, (const int *)s0, 0x0d800000, lanes);
    __bang_ge_scalar((int *)s4, (const int *)s0, 0x72800000, lanes);
    __bang_bor((char *)s5, (const char *)s5, (const char *)s3, lanes * 4);
    __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);

    __bang_band_scalar((int *)s0, (const int *)b_vec, 0x7f800000, lanes);
    __bang_mul_scalar((int *)s0, (const int *)s0, -1, lanes);
    __bang_add_scalar((int *)s0, (const int *)s0, 0x7f000000, lanes);
    __bang_band_scalar((int *)s1, (const int *)b_vec, (int)0x80000000U, lanes);
    __bang_bor((char *)s0, (const char *)s0, (const char *)s1, lanes * 4);
    __bang_mul(s1, (float *)b_vec, s0, lanes); // s1 = b' in [1, 2) exact
    if (a_is_vec)
      __bang_mul(s2, (float *)a_vec, s0, lanes); // s2 = a'
    else
      __bang_mul_scalar(s2, s0, a_scalar, lanes);
  } else {
    union {
      float f;
      unsigned u;
    } ub, uscale;
    ub.f = b_scalar;
    uscale.u = (0x7f000000U - (ub.u & 0x7f800000U)) | (ub.u & 0x80000000U);
    float scale = uscale.f;
    float bp = b_scalar * scale;
    __bang_band_scalar((int *)s1, (const int *)dst, 0, lanes);
    __bang_add_scalar(s1, s1, bp, lanes); // s1 = b' in [1, 2) exact
    __bang_mul_scalar(s2, (float *)a_vec, scale, lanes); // s2 = a'
  }

  // Certify |a'| in [2^-76, 2^102), guaranteeing a' = a * scale is exact.
  __bang_band_scalar((int *)s0, (const int *)s2, 0x7fffffff, lanes);
  __bang_lt_scalar((int *)s3, (const int *)s0, 0x19800000, lanes);
  __bang_ge_scalar((int *)s4, (const int *)s0, 0x72800000, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s3, lanes * 4);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);

  // (D2) Candidate |r| in (2^-76, 2^101) and non-power-of-two (M > 2^23).
  __bang_band_scalar((int *)s0, (const int *)dst, 0x7fffffff, lanes);
  __bang_lt_scalar((int *)s3, (const int *)s0, 0x19800001, lanes);
  __bang_ge_scalar((int *)s4, (const int *)s0, 0x72000000, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s3, lanes * 4);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);
  __bang_band_scalar((int *)s3, (const int *)dst, 0x007fffff, lanes);
  __bang_lt_scalar((int *)s3, (const int *)s3, 1, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s3, lanes * 4);

  // (D3) Exact P00 = b_hi * r_hi and runtime Sterbenz check on (a', P00).
  __bang_band_scalar((int *)s0, (const int *)s1, (int)0xfffff000U, lanes);
  __bang_band_scalar((int *)s3, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_mul(s0, s0, s3, lanes);
  __bang_bxor((char *)s3, (const char *)s2, (const char *)s0, lanes * 4);
  __bang_lt_scalar((int *)s3, (const int *)s3, 0, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s3, lanes * 4);
  __bang_band_scalar((int *)s3, (const int *)s2, 0x7fffffff, lanes);
  __bang_band_scalar((int *)s4, (const int *)s0, 0x7fffffff, lanes);
  __bang_mul_scalar((int *)s4, (const int *)s4, -1, lanes);
  __bang_add((int *)s3, (const int *)s3, (const int *)s4, lanes);
  __bang_lt_scalar((int *)s4, (const int *)s3, -0x00800000, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);
  __bang_ge_scalar((int *)s4, (const int *)s3, 0x00800001, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);
  __bang_sub(s2, s2, s0, lanes); // s2 = r0 = a' - P00 exact

  // (D4) Exact 4-term Knuth TwoDiff chain for a' - r * b'; require eB == eAB == eC == 0.
  __bang_band_scalar((int *)s0, (const int *)s1, (int)0xfffff000U, lanes);
  __bang_sub(s1, s1, s0, lanes); // s1 = b_lo
  __bang_band_scalar((int *)s3, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_sub(s3, dst, s3, lanes); // s3 = r_lo
  __bang_mul(s0, s0, s3, lanes);  // s0 = P10 = b_hi * r_lo
  BANG_TWODIFF(s2, s0, s3, s4, lanes); // s2 = sA, s0 = eA

  __bang_band_scalar((int *)s3, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_mul(s1, s3, s1, lanes);       // s1 = P01 = r_hi * b_lo
  BANG_TWODIFF(s2, s1, s3, s4, lanes); // s2 = sB, s1 = eB
  __bang_band_scalar((int *)s1, (const int *)s1, 0x7fffffff, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s1, lanes * 4);

  __bang_mul_scalar(s0, s0, -1.0f, lanes);
  BANG_TWODIFF(s2, s0, s3, s4, lanes); // s2 = sC, s0 = eAB (sB + eA)
  __bang_band_scalar((int *)s0, (const int *)s0, 0x7fffffff, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s0, lanes * 4);

  if (b_is_vec) {
    __bang_band_scalar((int *)s0, (const int *)b_vec, 0x7f800000, lanes);
    __bang_mul_scalar((int *)s0, (const int *)s0, -1, lanes);
    __bang_add_scalar((int *)s0, (const int *)s0, 0x7f000000, lanes);
    __bang_band_scalar((int *)s1, (const int *)b_vec, (int)0x80000000U, lanes);
    __bang_bor((char *)s0, (const char *)s0, (const char *)s1, lanes * 4);
    __bang_mul(s0, (float *)b_vec, s0, lanes); // s0 = b'
  } else {
    union {
      float f;
      unsigned u;
    } ub, uscale;
    ub.f = b_scalar;
    uscale.u = (0x7f000000U - (ub.u & 0x7f800000U)) | (ub.u & 0x80000000U);
    float bp = b_scalar * uscale.f;
    __bang_band_scalar((int *)s0, (const int *)dst, 0, lanes);
    __bang_add_scalar(s0, s0, bp, lanes); // s0 = b'
  }
  __bang_band_scalar((int *)s1, (const int *)s0, (int)0xfffff000U, lanes);
  __bang_sub(s1, s0, s1, lanes); // s1 = b_lo (s0 keeps b')
  __bang_band_scalar((int *)s3, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_sub(s3, dst, s3, lanes);
  __bang_mul(s1, s1, s3, lanes);       // s1 = P11 = b_lo * r_lo
  BANG_TWODIFF(s2, s1, s3, s4, lanes); // s2 = R_hi, s1 = eC
  __bang_band_scalar((int *)s1, (const int *)s1, 0x7fffffff, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s1, lanes * 4);

  // (D5) Symmetric exact endpoint check: -tau < R_hi < +tau, tau = 0.5 * b' * ulp(r).
  __bang_band_scalar((int *)s1, (const int *)dst, 0x7f800000, lanes);
  __bang_add_scalar((int *)s1, (const int *)s1, -0x0c000000, lanes);
  __bang_mul(s0, s0, s1, lanes);
  __bang_band_scalar((int *)s2, (const int *)s2, 0x7fffffff, lanes);
  __bang_mul_scalar((int *)s2, (const int *)s2, -1, lanes);
  __bang_add((int *)s0, (const int *)s0, (const int *)s2, lanes);
  __bang_lt_scalar((int *)s0, (const int *)s0, 1, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s0, lanes * 4);
}

__mlu_func__ void vec_div_rn(float *dst, const float *a, const float *b,
                             float *sc, int live, int lanes) {
  if (live <= 0)
    return;
  if (dst == a || dst == b) {
    __sync_compute();
    for (int i = 0; i < live; ++i)
      dst[i] = __cn_scalar_div_f32_rn(a[i], b[i]);
    return;
  }
  float *s0 = sc;
  float *s1 = sc + lanes;
  float *s2 = sc + 2 * lanes;
  float *s3 = sc + 3 * lanes;
  float *s4 = sc + 4 * lanes;
  float *s5 = sc + 5 * lanes;

  // Heuristic candidate generation (untrusted; only reduces fallback rate).
  __bang_band_scalar((int *)s0, (const int *)b, 0x7f800000, lanes);
  __bang_mul_scalar((int *)s0, (const int *)s0, -1, lanes);
  __bang_add_scalar((int *)s0, (const int *)s0, 0x7f000000, lanes);
  __bang_band_scalar((int *)s1, (const int *)b, (int)0x80000000U, lanes);
  __bang_bor((char *)s0, (const char *)s0, (const char *)s1, lanes * 4);
  __bang_mul(s1, (float *)b, s0, lanes);
  __bang_mul(s2, (float *)a, s0, lanes);

  __bang_active_recip(s0, s1, lanes);
  __bang_mul(s3, s1, s0, lanes);
  __bang_mul_scalar(s3, s3, -1.0f, lanes);
  __bang_add_scalar(s3, s3, 2.0f, lanes);
  __bang_mul(s0, s0, s3, lanes);
  __bang_mul(s3, s1, s0, lanes);
  __bang_mul_scalar(s3, s3, -1.0f, lanes);
  __bang_add_scalar(s3, s3, 2.0f, lanes);
  __bang_mul(s0, s0, s3, lanes);

  __bang_mul(dst, s2, s0, lanes);
  __bang_band_scalar((int *)s3, (const int *)s1, (int)0xfffff000U, lanes);
  __bang_sub(s1, s1, s3, lanes);
  __bang_band_scalar((int *)s4, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_mul(s4, s3, s4, lanes);
  __bang_sub(s2, s2, s4, lanes);

  __bang_band_scalar((int *)s4, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_sub(s4, dst, s4, lanes);
  __bang_mul(s3, s3, s4, lanes);
  BANG_TWODIFF(s2, s3, s4, s5, lanes);

  __bang_band_scalar((int *)s4, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_sub(s5, dst, s4, lanes);
  __bang_mul(s4, s1, s4, lanes);
  __bang_mul(s1, s1, s5, lanes);
  __bang_sub(s3, s3, s1, lanes);

  BANG_TWODIFF(s2, s4, s1, s5, lanes);
  __bang_add(s3, s3, s4, lanes);
  __bang_add(s2, s2, s3, lanes);
  __bang_mul(s2, s2, s0, lanes);
  __bang_add(dst, dst, s2, lanes);

  certify_div_rn_lanes(dst, a, 0.0f, 1, b, 0.0f, 1, sc, lanes);

  __bang_ne_scalar((int *)s5, (const int *)s5, 0, lanes);
  __bang_int322float(s0, (const int *)s5, lanes, 0);
  unsigned bad = __bang_count(s0, live);
  if (bad > 0) {
    __sync_compute();
    if (bad <= 16) {
      for (unsigned k = 0; k < bad; ++k) {
        unsigned idx = __bang_findfirst1(s0, live);
        ((volatile float *)dst)[idx] = __cn_scalar_div_f32_rn(a[idx], b[idx]);
        ((volatile float *)s0)[idx] = 0.0f;
        __sync_compute();
      }
    } else {
      for (int i = 0; i < live; ++i)
        if (((const volatile int *)s5)[i] != 0)
          dst[i] = __cn_scalar_div_f32_rn(a[i], b[i]);
    }
  }
}

__mlu_func__ void scalar_div_vec_rn(float *dst, float a, const float *b,
                                    float *sc, int live, int lanes) {
  if (live <= 0)
    return;
  union {
    float f;
    unsigned u;
  } ua;
  ua.f = a;
  unsigned a_mag = ua.u & 0x7fffffffU;
  if (dst == b || a_mag < 0x00800000U || a_mag >= 0x7f800000U) {
    __sync_compute();
    for (int i = 0; i < live; ++i)
      dst[i] = __cn_scalar_div_f32_rn(a, b[i]);
    return;
  }
  float *s0 = sc;
  float *s1 = sc + lanes;
  float *s2 = sc + 2 * lanes;
  float *s3 = sc + 3 * lanes;
  float *s4 = sc + 4 * lanes;
  float *s5 = sc + 5 * lanes;

  // Heuristic candidate generation (untrusted; only reduces fallback rate).
  __bang_band_scalar((int *)s0, (const int *)b, 0x7f800000, lanes);
  __bang_mul_scalar((int *)s0, (const int *)s0, -1, lanes);
  __bang_add_scalar((int *)s0, (const int *)s0, 0x7f000000, lanes);
  __bang_band_scalar((int *)s1, (const int *)b, (int)0x80000000U, lanes);
  __bang_bor((char *)s0, (const char *)s0, (const char *)s1, lanes * 4);
  __bang_mul(s1, (float *)b, s0, lanes);
  __bang_mul_scalar(s2, s0, a, lanes);

  __bang_active_recip(s0, s1, lanes);
  __bang_mul(s3, s1, s0, lanes);
  __bang_mul_scalar(s3, s3, -1.0f, lanes);
  __bang_add_scalar(s3, s3, 2.0f, lanes);
  __bang_mul(s0, s0, s3, lanes);
  __bang_mul(s3, s1, s0, lanes);
  __bang_mul_scalar(s3, s3, -1.0f, lanes);
  __bang_add_scalar(s3, s3, 2.0f, lanes);
  __bang_mul(s0, s0, s3, lanes);

  __bang_mul(dst, s2, s0, lanes);
  __bang_band_scalar((int *)s3, (const int *)s1, (int)0xfffff000U, lanes);
  __bang_sub(s1, s1, s3, lanes);
  __bang_band_scalar((int *)s4, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_mul(s4, s3, s4, lanes);
  __bang_sub(s2, s2, s4, lanes);

  __bang_band_scalar((int *)s4, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_sub(s4, dst, s4, lanes);
  __bang_mul(s3, s3, s4, lanes);
  BANG_TWODIFF(s2, s3, s4, s5, lanes);

  __bang_band_scalar((int *)s4, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_sub(s5, dst, s4, lanes);
  __bang_mul(s4, s1, s4, lanes);
  __bang_mul(s1, s1, s5, lanes);
  __bang_sub(s3, s3, s1, lanes);

  BANG_TWODIFF(s2, s4, s1, s5, lanes);
  __bang_add(s3, s3, s4, lanes);
  __bang_add(s2, s2, s3, lanes);
  __bang_mul(s2, s2, s0, lanes);
  __bang_add(dst, dst, s2, lanes);

  certify_div_rn_lanes(dst, (const float *)0, a, 0, b, 0.0f, 1, sc, lanes);

  __bang_ne_scalar((int *)s5, (const int *)s5, 0, lanes);
  __bang_int322float(s0, (const int *)s5, lanes, 0);
  unsigned bad = __bang_count(s0, live);
  if (bad > 0) {
    __sync_compute();
    if (bad <= 16) {
      for (unsigned k = 0; k < bad; ++k) {
        unsigned idx = __bang_findfirst1(s0, live);
        ((volatile float *)dst)[idx] = __cn_scalar_div_f32_rn(a, b[idx]);
        ((volatile float *)s0)[idx] = 0.0f;
        __sync_compute();
      }
    } else {
      for (int i = 0; i < live; ++i)
        if (((const volatile int *)s5)[i] != 0)
          dst[i] = __cn_scalar_div_f32_rn(a, b[i]);
    }
  }
}

__mlu_func__ void vec_div_scalar_rn(float *dst, const float *a, float b,
                                    float *sc, int live, int lanes) {
  if (live <= 0)
    return;
  union {
    float f;
    unsigned u;
  } ub;
  ub.f = b;
  unsigned b_mag = ub.u & 0x7fffffffU;
  if (dst == a || b_mag < 0x0d800000U || b_mag >= 0x72800000U) {
    __sync_compute();
    for (int i = 0; i < live; ++i)
      dst[i] = __cn_scalar_div_f32_rn(a[i], b);
    return;
  }
  float *s0 = sc;
  float *s1 = sc + lanes;
  float *s2 = sc + 2 * lanes;
  float *s3 = sc + 3 * lanes;
  float *s4 = sc + 4 * lanes;
  float *s5 = sc + 5 * lanes;

  // Heuristic candidate generation (untrusted; only reduces fallback rate).
  union {
    float f;
    unsigned u;
  } uscale, ubp, ubhi;
  uscale.u = (0x7f000000U - (ub.u & 0x7f800000U)) | (ub.u & 0x80000000U);
  float scale = uscale.f;
  ubp.f = b * scale;
  float bp = ubp.f;
  float y = __cn_scalar_div_f32_rn(1.0f, bp);
  ubhi.u = ubp.u & 0xfffff000U;
  float b_hi = ubhi.f;
  float b_lo = bp - b_hi;

  __bang_mul_scalar(s2, (float *)a, scale, lanes);
  __bang_mul_scalar(dst, s2, y, lanes);
  __bang_band_scalar((int *)s0, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_sub(s1, dst, s0, lanes);
  __bang_mul_scalar(s0, s0, b_hi, lanes);
  __bang_sub(s2, s2, s0, lanes);

  __bang_mul_scalar(s3, s1, b_hi, lanes);
  BANG_TWODIFF(s2, s3, s0, s4, lanes);

  __bang_mul_scalar(s1, s1, b_lo, lanes);
  __bang_sub(s3, s3, s1, lanes);

  __bang_band_scalar((int *)s4, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_mul_scalar(s4, s4, b_lo, lanes);
  BANG_TWODIFF(s2, s4, s0, s1, lanes);
  __bang_add(s3, s3, s4, lanes);
  __bang_add(s2, s2, s3, lanes);
  __bang_mul_scalar(s2, s2, y, lanes);
  __bang_add(dst, dst, s2, lanes);

  certify_div_rn_lanes(dst, a, 0.0f, 1, (const float *)0, b, 0, sc, lanes);

  __bang_ne_scalar((int *)s5, (const int *)s5, 0, lanes);
  __bang_int322float(s0, (const int *)s5, lanes, 0);
  unsigned bad = __bang_count(s0, live);
  if (bad > 0) {
    __sync_compute();
    if (bad <= 16) {
      for (unsigned k = 0; k < bad; ++k) {
        unsigned idx = __bang_findfirst1(s0, live);
        ((volatile float *)dst)[idx] = __cn_scalar_div_f32_rn(a[idx], b);
        ((volatile float *)s0)[idx] = 0.0f;
        __sync_compute();
      }
    } else {
      for (int i = 0; i < live; ++i)
        if (((const volatile int *)s5)[i] != 0)
          dst[i] = __cn_scalar_div_f32_rn(a[i], b);
    }
  }
}

#undef BANG_TWODIFF
