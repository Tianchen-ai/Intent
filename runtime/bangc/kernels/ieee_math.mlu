// Certified IEEE-754 binary32 square root (vec_sqrt_rn).
//   Given input x and untrusted candidate r = dst[i], lane i is accepted iff
//   all runtime checks (C1)-(C5) evaluate to 0 (otherwise scalar_sqrt_f32_rn(x)
//   overwrites dst[i]):
//     (C1) 0x19800000 <= x_bits < 0x72800000 (signed int32): x is finite
//          positive normal in [2^-76, 2^102) (rejects negatives, +-0, subnormals,
//          Inf, and NaN). Every such x is an integer multiple of >= 2^-99.
//     (C2) 0x2c800001 <= r_bits < 0x59000000 (signed int32) and
//          (r_bits & 0x007fffff) != 0: r is finite positive normal in
//          (2^-38, 2^51) and not an exact power of two. Writing r = M * delta
//          with integer M in [2^23 + 1, 2^24 - 1] and delta = ulp(r) =
//          2^(exp(r) - 150) in [2^-61, 2^27], both adjacent binary32 floats of
//          r are symmetrically r - delta and r + delta, so the exact IEEE-754
//          RN rounding interval around r has midpoints m_- = r - 0.5 * delta > 0
//          and m_+ = r + 0.5 * delta > 0. Thus m_-^2 < x < m_+^2, i.e.,
//            -r * delta + 0.25 * delta^2 < x - r^2 < r * delta + 0.25 * delta^2,
//          suffices unconditionally for RN(sqrt(x)) == r.
//     (C3) Masking with 0xfffff000U splits r = r_hi + r_lo into <=12-bit halves.
//          All three products P0 = r_hi^2 in [2^-76, 2^102), P1 = 2*r_hi*r_lo
//          (0 or >= 2^-109), and P2 = r_lo^2 (0 or >= 2^-122) have <=24
//          significand bits and are integer multiples of delta^2 >= 2^-122 >
//          2^-126, hence exact in binary32 without overflow or subnormal FTZ.
//          Runtime check -0x00800000 <= (x_bits & 0x7fffffff) -
//          (P0_bits & 0x7fffffff) <= +0x00800000 verifies 0.5 * P0 <= x <= 2 * P0
//          directly on (x, P0); since both are multiples of >= 2^-99 > 2^-126,
//          Sterbenz's Lemma guarantees r0 = fl(x - P0) = x - P0 is exact.
//     (C4) Knuth TwoDiff(r0, P1) -> (s1, e1) and TwoDiff(s1, P2) -> (R_hi, e2).
//          Because x >= 0.5 * P0 >= 2^45 * delta^2 has ulp(x) >= 2^22 * delta^2,
//          every operand and intermediate in both TwoDiff steps is an integer
//          multiple of delta^2 >= 2^-122 > 2^-126 with magnitude < 2^103, so
//          neither FTZ nor overflow can occur and x - r^2 = R_hi + e1 + e2
//          holds with mathematical exactness. Runtime checks (e1_bits & 0x7fffffff)
//          == 0 and (e2_bits & 0x7fffffff) == 0 certify R_hi == x - r^2 exactly.
//     (C5) tau = fl(r * delta) = M * delta^2 in (2^-99, 2^78) is exact. Runtime
//          check |R_hi| < tau (evaluated symmetrically on non-negative bit
//          patterns as tau_bits - |R_hi|_bits >= 1, which also rejects Inf/NaN)
//          certifies -tau < x - r^2 < +tau. Since R_hi = K * delta^2 and
//          tau = M * delta^2 are both integer multiples of delta^2, |K| < M
//          implies -M + 1 <= K <= M - 1, hence -M + 0.25 < K < M + 0.25 and
//          m_-^2 < x < m_+^2 on both boundaries, proving RN(sqrt(x)) == r.
//
#define BANG_TWODIFF_SE(s_out, u, v_e, t, n)                                   \
  do {                                                                         \
    __bang_sub(s_out, u, v_e, n);                                              \
    __bang_add(t, s_out, v_e, n);                                              \
    __bang_sub(u, u, t, n);                                                    \
    __bang_sub(t, t, s_out, n);                                                \
    __bang_sub(v_e, t, v_e, n);                                                \
    __bang_add(v_e, u, v_e, n);                                                \
  } while (0)

__mlu_func__ float scalar_sqrt_f32_rn(float x) {
  union {
    float f;
    unsigned u;
  } ux;
  ux.f = x;
  unsigned u = ux.u;
  unsigned mag = u & 0x7fffffffU;
  if (mag == 0U)
    return x; // preserves +0.0f and -0.0f
  if (mag > 0x7f800000U)
    return x; // propagates NaN
  if ((u >> 31) != 0U) {
    ux.u = 0x7fc00000U;
    return ux.f; // negative -> qNaN
  }
  if (u == 0x7f800000U)
    return x; // +Inf -> +Inf

  int exp = (int)((u >> 23) & 0xffU) - 127;
  unsigned m = u & 0x7fffffU;
  if (((u >> 23) & 0xffU) == 0U) {
    exp = -126;
    while ((m & 0x800000U) == 0U) {
      m <<= 1;
      --exp;
    }
  } else {
    m |= 0x800000U;
  }
  if (exp & 1) {
    m <<= 1;
    --exp;
  }
  int out_exp = (exp >> 1) + 127;

  // Compute root = floor(sqrt(m * 2^25)) in [2^24, 2^25) using pure 32-bit
  // restoring digit-by-digit square root (zero 64-bit ALU ops). Since m * 2^25
  // is even while (2k + 1)^2 is odd, (root + 1) >> 1 is exact RN-even for all x.
  unsigned rem = 0U;
  unsigned root = 0U;
  unsigned hi = m << 7;
  for (int i = 0; i < 25; ++i) {
    rem = (rem << 2) | (hi >> 30);
    hi <<= 2;
    unsigned cand = (root << 2) | 1U;
    root <<= 1;
    if (rem >= cand) {
      rem -= cand;
      root |= 1U;
    }
  }
  unsigned sig = (root + 1U) >> 1;
  if (sig == (1U << 24)) {
    sig >>= 1;
    ++out_exp;
  }
  ux.u = ((unsigned)out_exp << 23) | (sig & 0x7fffffU);
  return ux.f;
}

// Unconditional symmetric runtime endpoint certification for candidate r = dst
// against sqrt(src), writing per-lane fault flags (0 = certified 0-ULP,
// !=0 = fallback) into s5 = sc + 5 * lanes.
__mlu_func__ void certify_sqrt_rn_lanes(float *dst, const float *src, float *sc,
                                        int lanes) {
  float *s0 = sc;
  float *s1 = sc + lanes;
  float *s2 = sc + 2 * lanes;
  float *s3 = sc + 3 * lanes;
  float *s4 = sc + 4 * lanes;
  float *s5 = sc + 5 * lanes;

  // (C1) x in [2^-76, 2^102) positive finite normal.
  __bang_lt_scalar((int *)s5, (const int *)src, 0x19800000, lanes);
  __bang_ge_scalar((int *)s4, (const int *)src, 0x72800000, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);

  // (C2) r in (2^-38, 2^51) positive normal and non-power-of-two (M > 2^23).
  __bang_lt_scalar((int *)s3, (const int *)dst, 0x2c800001, lanes);
  __bang_ge_scalar((int *)s4, (const int *)dst, 0x59000000, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s3, lanes * 4);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);
  __bang_band_scalar((int *)s3, (const int *)dst, 0x007fffff, lanes);
  __bang_lt_scalar((int *)s3, (const int *)s3, 1, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s3, lanes * 4);

  // (C3) Exact 12+12 split of r and runtime Sterbenz check 0.5*P0 <= x <= 2*P0.
  __bang_band_scalar((int *)s0, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_sub(s1, dst, s0, lanes);
  __bang_mul(s2, s0, s0, lanes);
  __bang_band_scalar((int *)s3, (const int *)src, 0x7fffffff, lanes);
  __bang_band_scalar((int *)s4, (const int *)s2, 0x7fffffff, lanes);
  __bang_mul_scalar((int *)s4, (const int *)s4, -1, lanes);
  __bang_add((int *)s3, (const int *)s3, (const int *)s4, lanes);
  __bang_lt_scalar((int *)s4, (const int *)s3, -0x00800000, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);
  __bang_ge_scalar((int *)s4, (const int *)s3, 0x00800001, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s4, lanes * 4);

  // (C4) Exact TwoDiff chain for R_hi + e1 + e2 == x - r^2; require e1 == e2 == 0.
  __bang_sub(s2, (float *)src, s2, lanes);
  __bang_mul(s3, s0, s1, lanes);
  __bang_add(s3, s3, s3, lanes);
  __bang_mul(s0, s1, s1, lanes);
  BANG_TWODIFF_SE(s1, s2, s3, s4, lanes);
  __bang_band_scalar((int *)s3, (const int *)s3, 0x7fffffff, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s3, lanes * 4);
  BANG_TWODIFF_SE(s2, s1, s0, s4, lanes);
  __bang_band_scalar((int *)s0, (const int *)s0, 0x7fffffff, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s0, lanes * 4);

  // (C5) Symmetric exact endpoint check: -tau < R_hi < +tau (tau = r * ulp(r)).
  __bang_band_scalar((int *)s0, (const int *)dst, 0x7f800000, lanes);
  __bang_add_scalar((int *)s0, (const int *)s0, -0x0b800000, lanes);
  __bang_mul(s0, dst, s0, lanes);
  __bang_band_scalar((int *)s2, (const int *)s2, 0x7fffffff, lanes);
  __bang_mul_scalar((int *)s2, (const int *)s2, -1, lanes);
  __bang_add((int *)s0, (const int *)s0, (const int *)s2, lanes);
  __bang_lt_scalar((int *)s0, (const int *)s0, 1, lanes);
  __bang_bor((char *)s5, (const char *)s5, (const char *)s0, lanes * 4);
}

__mlu_func__ void vec_sqrt_rn(float *dst, const float *src, float *sc, int live,
                              int lanes) {
  if (live <= 0)
    return;
  if (dst == src) {
    __sync_compute();
    for (int i = 0; i < live; ++i)
      dst[i] = scalar_sqrt_f32_rn(src[i]);
    return;
  }
  float *s0 = sc;
  float *s1 = sc + lanes;
  float *s2 = sc + 2 * lanes;
  float *s3 = sc + 3 * lanes;
  float *s4 = sc + 4 * lanes;
  float *s5 = sc + 5 * lanes;

  // Heuristic candidate generation (untrusted; only reduces fallback rate).
  __bang_sqrt(dst, src, lanes);
  __bang_add(s1, dst, dst, lanes);
  __bang_band_scalar((int *)s0, (const int *)s1, 0x7f800000, lanes);
  __bang_mul_scalar((int *)s0, (const int *)s0, -1, lanes);
  __bang_add_scalar((int *)s0, (const int *)s0, 0x7f000000, lanes);
  __bang_mul(s2, s1, s0, lanes);
  __bang_active_recip(s3, s2, lanes);
  __bang_mul(s4, s2, s3, lanes);
  __bang_mul_scalar(s4, s4, -1.0f, lanes);
  __bang_add_scalar(s4, s4, 2.0f, lanes);
  __bang_mul(s3, s3, s4, lanes);
  __bang_mul(s4, s2, s3, lanes);
  __bang_mul_scalar(s4, s4, -1.0f, lanes);
  __bang_add_scalar(s4, s4, 2.0f, lanes);
  __bang_mul(s3, s3, s4, lanes);
  __bang_mul(s0, s3, s0, lanes);

  __bang_band_scalar((int *)s1, (const int *)dst, (int)0xfffff000U, lanes);
  __bang_sub(s2, dst, s1, lanes);
  __bang_mul(s3, s1, s1, lanes);
  __bang_sub(s3, (float *)src, s3, lanes);
  __bang_mul(s1, s1, s2, lanes);
  __bang_add(s1, s1, s1, lanes);
  __bang_sub(s3, s3, s1, lanes);
  __bang_mul(s2, s2, s2, lanes);
  __bang_sub(s3, s3, s2, lanes);
  __bang_mul(s3, s3, s0, lanes);
  __bang_add(dst, dst, s3, lanes);

  certify_sqrt_rn_lanes(dst, src, sc, lanes);

  __bang_ne_scalar((int *)s5, (const int *)s5, 0, lanes);
  __bang_int322float(s0, (const int *)s5, lanes, 0);
  unsigned bad = __bang_count(s0, live);
  if (bad > 0) {
    __sync_compute();
    if (bad <= 16) {
      for (unsigned k = 0; k < bad; ++k) {
        unsigned idx = __bang_findfirst1(s0, live);
        ((volatile float *)dst)[idx] = scalar_sqrt_f32_rn(src[idx]);
        ((volatile float *)s0)[idx] = 0.0f;
        __sync_compute();
      }
    } else {
      for (int i = 0; i < live; ++i)
        if (((const volatile int *)s5)[i] != 0)
          dst[i] = scalar_sqrt_f32_rn(src[i]);
    }
  }
}

#undef BANG_TWODIFF_SE
