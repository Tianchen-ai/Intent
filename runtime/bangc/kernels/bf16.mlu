__mlu_func__ float widen_bf16(unsigned short bits) {
  union {
    unsigned u;
    float f;
  } x;
  x.u = (unsigned)bits << 16;
  return x.f;
}

__mlu_func__ unsigned short round_bf16(float x) {
  union {
    unsigned u;
    float f;
  } word;
  word.f = x;
  if ((word.u & 0x7fffffffU) > 0x7f800000U)
    return (word.u >> 16) | 0x40U;
  return (word.u + 0x7fffU + ((word.u >> 16) & 1U)) >> 16;
}

__mlu_func__ void widen_bf16_tile(float *dst, const unsigned short *src,
                                  int lanes) {
  __bang_int162int32((int *)dst, (const short *)src, lanes, 0, 16);
}

__mlu_func__ void narrow_bf16_tile(unsigned short *dst, const float *src,
                                   int live, int lanes) {
  __bang_float2bfloat16_rn((bfloat16_t *)dst, src, lanes);
  __bang_band_scalar((short *)dst, (const short *)dst, (short)0x7fff, lanes);
  __bang_ge_scalar((short *)dst, (const short *)dst, (short)0x7f7f, lanes);
  if (__bang_count(dst, live)) {
    for (int i = 0; i < live; ++i)
      dst[i] = round_bf16(src[i]);
  } else {
    __bang_float2bfloat16_rn((bfloat16_t *)dst, src, lanes);
  }
}

__mlu_func__ void bf16_product_tile(unsigned short *dst,
                                    const unsigned short *lhs,
                                    const unsigned short *rhs, float *scratch,
                                    int live, int lanes) {
  float *a = scratch;
  float *b = scratch + lanes;
  widen_bf16_tile(a, lhs, lanes);
  widen_bf16_tile(b, rhs, lanes);
  __bang_mul(a, a, b, lanes);
  narrow_bf16_tile(dst, a, live, lanes);
}
