__mlu_func__ void row_exp(float *out, float *scratch, const float *in, int live,
                          int lanes) {
  bool repair = true;
  int full = (live / 32) * 32;
  if (full >= 32) {
    __bang_abs(scratch, in, lanes);
    __bang_maxpool(scratch, scratch, 32, full / 32, 1, full / 32, 1, 1, 1);
    __bang_argmax(scratch, scratch, 32);
    __sync_compute();
    repair = !(((volatile float *)scratch)[0] <= 80.0f);
    for (int k = full; !repair && k < live; ++k) {
      float x = in[k];
      if (!(x >= -80.0f && x <= 80.0f))
        repair = true;
    }
  } else if (live >= 4) {
    __bang_abs(scratch, in, lanes);
    __bang_argmax(scratch, scratch, live);
    __sync_compute();
    repair = !(((volatile float *)scratch)[0] <= 80.0f);
  }
  if (!repair) {
    __bang_active_exphp(out, in, lanes);
    return;
  }
  if (live == lanes && lanes >= 64 && (lanes % 64 == 0) && out != in) {
    const int *ib = (const int *)in;
    int *sc = (int *)scratch;
    int *oc = (int *)out;
    // Bad iff: (ib > 0x42a00000) || (ib in [0xff800001, 0xffffffff]) || (ib in [0xc2a00001, 0xc2cfffff]).
    __bang_sub_scalar(sc, ib, (int)0xff800001u, lanes);
    __bang_lt_scalar((unsigned int *)sc, (const unsigned int *)sc, 0x007fffffu,
                     lanes);
    __bang_ge_scalar(oc, ib, 0x42a00001, lanes);
    __bang_bor(sc, sc, oc, lanes);
    __bang_sub_scalar(oc, ib, (int)0xc2a00001u, lanes);
    __bang_lt_scalar((unsigned int *)oc, (const unsigned int *)oc, 0x002fffffu,
                     lanes);
    __bang_bor(sc, sc, oc, lanes);
    __bang_int322float((float *)sc, sc, lanes, 0);
    if (__bang_count((float *)sc, lanes) == 0) {
      __bang_sub_scalar(sc, ib, (int)0xc2d00000u, lanes);
      __bang_ge_scalar((unsigned int *)sc, (const unsigned int *)sc,
                       0x3cb00001u, lanes);
      __bang_mul_scalar(sc, sc, -1, lanes);
      __bang_band(oc, ib, sc, lanes);
      __bang_active_exphp(out, (const float *)oc, lanes);
      __bang_band((int *)out, (const int *)out, sc, lanes);
      return;
    }
  }
  __sync_compute();
  for (int k = 0; k < live; ++k)
    scratch[k] = in[k];
  __sync();
  __bang_active_exphp(out, in, lanes);
  __sync_compute();
  for (int k = 0; k < live; ++k) {
    float x = scratch[k];
    if (!(x >= -80.0f && x <= 80.0f))
      out[k] = x <= -104.0f ? 0.0f : (x == INFINITY ? INFINITY : expf(x));
  }
  __sync();
}

__mlu_func__ void row_exp2(float *out, float *scratch, const float *in,
                           int live, int lanes) {
  bool repair = true;
  int full = (live / 32) * 32;
  if (full >= 32) {
    __bang_abs(scratch, in, lanes);
    __bang_maxpool(scratch, scratch, 32, full / 32, 1, full / 32, 1, 1, 1);
    __bang_argmax(scratch, scratch, 32);
    __sync_compute();
    repair = !(((volatile float *)scratch)[0] <= 115.0f);
    for (int k = full; !repair && k < live; ++k) {
      float x = in[k];
      if (!(x >= -115.0f && x <= 115.0f))
        repair = true;
    }
  } else if (live >= 4) {
    __bang_abs(scratch, in, lanes);
    __bang_argmax(scratch, scratch, live);
    __sync_compute();
    repair = !(((volatile float *)scratch)[0] <= 115.0f);
  }
  if (!repair) {
    __bang_mul_scalar(out, in, 0.6931471805599453f, lanes);
    __bang_active_exphp(out, out, lanes);
    return;
  }
  if (live == lanes && lanes >= 64 && (lanes % 64 == 0) && out != in) {
    const int *ib = (const int *)in;
    int *sc = (int *)scratch;
    int *oc = (int *)out;
    // Bad iff: (ib > 0x42e60000) || (ib in [0xff800001, 0xffffffff]) || (ib in [0xc2e60001, 0xc315ffff]).
    __bang_sub_scalar(sc, ib, (int)0xff800001u, lanes);
    __bang_lt_scalar((unsigned int *)sc, (const unsigned int *)sc, 0x007fffffu,
                     lanes);
    __bang_ge_scalar(oc, ib, 0x42e60001, lanes);
    __bang_bor(sc, sc, oc, lanes);
    __bang_sub_scalar(oc, ib, (int)0xc2e60001u, lanes);
    __bang_lt_scalar((unsigned int *)oc, (const unsigned int *)oc, 0x002fffffu,
                     lanes);
    __bang_bor(sc, sc, oc, lanes);
    __bang_int322float((float *)sc, sc, lanes, 0);
    if (__bang_count((float *)sc, lanes) == 0) {
      // Underflow [-Inf, -150]: ib in [0xc3160000, 0xff800000] -> span 0x3c6a0000u.
      __bang_sub_scalar(sc, ib, (int)0xc3160000u, lanes);
      __bang_ge_scalar((unsigned int *)sc, (const unsigned int *)sc,
                       0x3c6a0001u, lanes);
      __bang_mul_scalar(sc, sc, -1, lanes);
      __bang_band(oc, ib, sc, lanes);
