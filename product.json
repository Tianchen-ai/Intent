{
  "name": "intentdsl",
  "version": "2.0.0.dev0",
  "compilerinfra": "0.3.3",
  "levels": [
    {
      "name": "algorithm",
      "responsibility": "Author semantics and numerical contracts"
    },
    {
      "name": "execution",
      "responsibility": "Program instances, member coverage and traversal"
    },
    {
      "name": "storage",
      "responsibility": "Explicit supply, completion and storage lifetimes"
    }
  ],
  "nodes": [
    {
      "name": "kir",
      "level": "algorithm",
      "parent": "entry",
      "contract": "Typed logical member computation",
      "boundaries": [
        "imported",
        "canonical"
      ]
    },
    {
      "name": "block",
      "level": "execution",
      "parent": "kir@canonical",
      "contract": "Parameterized block program",
      "boundaries": [
        "formed",
        "decided",
        "realized",
        "normalized"
      ]
    },
    {
      "name": "cpu",
      "level": "execution",
      "parent": "kir@canonical",
      "contract": "Isolated row tasks over structured SSA values",
      "boundaries": [
        "formed",
        "tasked",
        "buffers"
      ]
    },
    {
      "name": "dsa",
      "level": "storage",
      "parent": "block@realized",
      "contract": "Owned tile stages with explicit transfers and completion",
      "boundaries": [
        "formed",
        "supplied"
      ]
    }
  ],
  "exits": [
    {
      "name": "triton",
      "at": "block@normalized",
      "description": "Local GPU Triton compiler",
      "boundaries": [
        "legal",
        "callable"
      ]
    },
    {
      "name": "weft",
      "at": "cpu@tasked",
      "description": "Synchronous native CPU program",
      "boundaries": [
        "legal",
        "callable"
      ]
    },
    {
      "name": "mojo",
      "at": "cpu@buffers",
      "description": "Synchronous native CPU program",
      "boundaries": [
        "legal",
        "realized",
        "callable"
      ]
    },
    {
      "name": "cutile",
      "at": "block@normalized",
      "description": "CUDA Tile Python array programs",
      "boundaries": [
        "legal",
        "callable"
      ]
    },
    {
      "name": "bangc",
      "at": "dsa@supplied",
      "description": "Native BANG C program and CNRT queue entry",
      "boundaries": [
        "bound",
        "legal",
        "callable"
      ]
    }
  ],
  "runtimes": [
    "cpu",
    "kir",
    "block",
    "triton",
    "weft",
    "mojo",
    "cutile",
    "bangc"
  ],
  "frontend": {
    "language": "python",
    "entry": "author:root_ir"
  },
  "configuration": "cmake/default.json",
  "build": {
    "configure_args": []
  },
  "bench": {
    "package": "intent_bench.compilerinfra_adapter"
  },
  "install": {
    "python": "python3"
  }
}
