{
  "name": "intentdsl",
  "version": "2.0.0.dev0",
  "compilerinfra": "0.2.0",
  "levels": [
    {
      "name": "algorithm",
      "responsibility": "Author semantics and numerical contracts"
    },
    {
      "name": "execution",
      "responsibility": "Program instances, member coverage and traversal"
    }
  ],
  "nodes": [
    {
      "name": "kir",
      "level": "algorithm",
      "parent": "entry",
      "contract": "Typed logical member computation",
      "boundaries": [
        "imported",
        "canonical"
      ]
    },
    {
      "name": "block",
      "level": "execution",
      "parent": "kir@canonical",
      "contract": "Parameterized block program",
      "boundaries": [
        "formed",
        "decided",
        "realized",
        "normalized"
      ]
    }
  ],
  "exits": [
    {
      "name": "triton",
      "at": "block@normalized",
      "description": "Local GPU Triton compiler",
      "boundaries": [
        "legal",
        "callable"
      ]
    }
  ],
  "runtimes": [
    "kir",
    "block",
    "triton"
  ],
  "frontend": {
    "language": "python",
    "entry": "author:root_ir"
  },
  "configuration": "cmake/default.json",
  "build": {
    "configure_args": []
  },
  "bench": {"package": "intent_bench.compilerinfra_adapter"},
  "install": {
    "python": "python3"
  }
}
