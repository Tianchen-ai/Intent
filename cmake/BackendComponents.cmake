function(intent_backend name)
  cmake_parse_arguments(BACKEND "" "SOURCE;PROFILE;PROFILE_NAME" "SOURCES;LIBRARIES" ${ARGN})
  if(NOT BACKEND_SOURCE OR BACKEND_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "intent_backend requires SOURCE and optional LIBRARIES")
  endif()
  get_property(names GLOBAL PROPERTY INTENT_BACKEND_NAMES)
  if(name IN_LIST names)
    message(FATAL_ERROR "Duplicate Intent backend component: ${name}")
  endif()
  set_property(GLOBAL APPEND PROPERTY INTENT_BACKEND_NAMES "${name}")
  foreach(input IN ITEMS ${BACKEND_SOURCE} ${BACKEND_SOURCES})
    get_filename_component(source "${input}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    set_property(GLOBAL APPEND PROPERTY INTENT_BACKEND_SOURCES "${source}")
  endforeach()
  set_property(GLOBAL APPEND PROPERTY INTENT_BACKEND_LIBRARIES ${BACKEND_LIBRARIES})
  if(BACKEND_PROFILE)
    if(NOT BACKEND_PROFILE_NAME)
      message(FATAL_ERROR "A backend configuration resource requires PROFILE_NAME")
    endif()
    get_filename_component(profile "${BACKEND_PROFILE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    set_property(GLOBAL APPEND PROPERTY INTENT_PROFILE_NAMES "${BACKEND_PROFILE_NAME}")
    set_property(GLOBAL APPEND PROPERTY INTENT_PROFILE_SOURCES "${profile}")
  endif()
  set(LLVM_OPTIONAL_SOURCES ${LLVM_OPTIONAL_SOURCES} ${BACKEND_SOURCE} ${BACKEND_SOURCES} PARENT_SCOPE)
endfunction()
